AddressFamily inet

HostKey /etc/ssh/ssh_host_ed25519_key
Ciphers aes128-gcm@openssh.com,aes128-cbc,aes128-ctr

# Extra algorithms for some clients
KexAlgorithms +diffie-hellman-group-exchange-sha256  # For SSH Custom (Android)
KexAlgorithms +curve25519-sha256  # General good for modern clients

# Auth options
LoginGraceTime 10
PermitRootLogin no
MaxAuthTries 3

# Disable all shell and subsystem logins, allowing only forwarding
MaxSessions 0

# Disable compression
Compression no

# Password auth
AuthenticationMethods password
PubkeyAuthentication no
PasswordAuthentication yes
KbdInteractiveAuthentication yes
PermitEmptyPasswords no

# Securing
StrictModes yes
AllowAgentForwarding no
AllowGroups tunnel

# Send client alive messages every 5 seconds
# and disconnect after 60 seconds without answer
ClientAliveInterval 5
ClientAliveCountMax 12
